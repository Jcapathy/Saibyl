# LLM
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-7
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_BASE_URL=

# Database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Storage
SUPABASE_STORAGE_BUCKET=saibyl-uploads

# App
SECRET_KEY=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Billing
#
# These two are the whole of it. There is deliberately no price id: a credit
# top-up is any amount between $10 and $500, so `create_topup_checkout` builds
# its price inline with `price_data` rather than referencing a Stripe product.
# Nothing in the product needs a Stripe product or price to be created by hand.
#
# Both must come from the SAME Stripe mode. A live secret key with a test
# webhook secret is the classic failure: the payment succeeds, Stripe posts the
# event, signature verification rejects it, and the credits never land.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# Monitoring
SENTRY_DSN=

# Simulation
SIMULATION_MAX_ROUNDS=10
SIMULATION_WORKER_CONCURRENCY=4
